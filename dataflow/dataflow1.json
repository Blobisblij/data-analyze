			"scriptLines": [
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     validationMode: 'none',",
				"     namespaces: true) ~> COMPLEX",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     validationMode: 'none',",
				"     namespaces: true) ~> ELEMENT",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     namespaces: true) ~> ELEMENTWAARDE",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     namespaces: true) ~> OBJECT",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     validationMode: 'none',",
				"     namespaces: true,",
				"     dateFormats: ['dd/MM/yyyy'],",
				"     timestampFormats: ['dd/MM/yyyy'],",
				"     preferredIntegralType: 'geheel getal',",
				"     preferredFractionalType: 'float') ~> POSTCODE",
				"source(output(",
				"          WOD_ID as string,",
				"          NWS_ID as string,",
				"          WVZ_ID as string,",
				"          OPDRACHTDATUM as string,",
				"          STARTDATUM as string,",
				"          EINDDATUM as string,",
				"          BONVOLG as string,",
				"          AFGEROND as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> WERKOPDRACHT",
				"source(output(",
				"          NWS_ID as long,",
				"          CODE as long,",
				"          OMSCHRIJVING as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> WERKSOORT",
				"source(output(",
				"          WVZ_ID as string,",
				"          CST_ID_INVOER as string,",
				"          MELDDATUM as string,",
				"          OMSCHRIJVING as string,",
				"          BONJAAR as string,",
				"          BONNUMMER as string,",
				"          AFGEROND as string,",
				"          OBJECT_NAAM as string,",
				"          STRAAT as string,",
				"          HUISNUMMER as string,",
				"          WOONPLAATS as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> WERKVERZOEK",
				"source(output(",
				"          WOD_ID as long,",
				"          NWS_ID as long,",
				"          WVZ_ID as long,",
				"          OPDRACHTDATUM as timestamp,",
				"          STARTDATUM as timestamp,",
				"          EINDDATUM as timestamp,",
				"          BONVOLG as long,",
				"          AFGEROND as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> OPDRACHT",
				"source(output(",
				"          PPP_ID as long,",
				"          PPP_PROJECT_OMS as string,",
				"          PPP_STARTDATUM as timestamp,",
				"          PPP_EINDDATUM as timestamp,",
				"          PPP_MEMO as string,",
				"          PPP_BEGROTINGSOM_INCL_BTW as double",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> PROJECT",
				"source(output(",
				"          PPR_ID as long,",
				"          PPP_ID as long,",
				"          PPR_START_DATUM as timestamp,",
				"          PPR_EIND_DATUM as timestamp,",
				"          PPR_JAAR as long,",
				"          PPR_OMSCHRIJVING as string,",
				"          PPR_MEMO as string,",
				"          PPR_TOTAAL_BEGROOT as double,",
				"          OBJECT_ID as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> PROJECTREGEL",
				"source(output(",
				"          NWS_ID as long,",
				"          CODE as long,",
				"          OMSCHRIJVING as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SOORT",
				"source(output(",
				"          WVZ_ID as long,",
				"          PPP_ID as long,",
				"          CST_ID_INVOER as long,",
				"          MELDDATUM as timestamp,",
				"          MEMO as string,",
				"          BONJAAR as long,",
				"          BONNUMMER as long,",
				"          AFGEROND as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> WERK",
				"WERKSOORT, SOORT union(byName: true)~> soortunion",
				"WERKOPDRACHT, OPDRACHT union(byName: true)~> opdrachtunion",
				"WERKVERZOEK, WERK union(byName: true)~> werkunion",
				"split1@POSTCODE, POSTCODE union(byName: true)~> union1",
				"werkunion select(mapColumn(",
				"          STRAAT,",
				"          HUISNUMMER,",
				"          WOONPLAATS",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> postcodeselect",
				"werkunion select(mapColumn(",
				"          WVZ_ID,",
				"          CST_ID_INVOER,",
				"          MELDDATUM,",
				"          OMSCHRIJVING,",
				"          BONJAAR,",
				"          BONNUMMER,",
				"          AFGEROND,",
				"          OBJECT_NAAM,",
				"          PPP_ID,",
				"          MEMO",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"postcodeselect, POSTCODE join(ERROR_FUNCTION('') == ERROR_FUNCTION(''),",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"soortunion sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          SOORT_ID as integer,",
				"          CODE as integer,",
				"          OMSCHRIJVING as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> WERKSOORTOLTP",
				"COMPLEX sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          BOT_ID as integer,",
				"          INGANGSDATUM as string,",
				"          VOLGNUMMER as string,",
				"          TYPEN as string,",
				"          DATUMEINDE as string,",
				"          SUBCOMPLEX as string,",
				"          ETAGE as double,",
				"          GANG as double,",
				"          COMPLEX_STATUS as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> COMPLEXOLTP",
				"ELEMENT sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ELEMENT_ID as integer,",
				"          VOLGNUMMER as double,",
				"          WAARDEAANDUIDING as string,",
				"          ELEMENT as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> ELEMENTOLTP",
				"ELEMENTWAARDE sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ELEMENTWAARDE_ID as integer,",
				"          ELEMENT_ID as integer,",
				"          BOT_ID as integer,",
				"          ALFA as string,",
				"          DATUM as string,",
				"          NUM as double,",
				"          ELEMENT_DEC as string,",
				"          PUNTEN as double",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> ELEMENTWAARDEOLTP",
				"OBJECT sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          BOT_ID as integer,",
				"          INGANGSDATUM as string,",
				"          OBJECT_TYPE as string,",
				"          DEABYN as string,",
				"          ADRES_ID as integer,",
				"          NAAM as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> OBJECTOLTP",
				"POSTCODE sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ADRES_ID as integer,",
				"          POSTCODE as string,",
				"          HUISNUMMER as integer,",
				"          STRAATNAAM as string,",
				"          WOONPLAATS as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> ADRESOLTP",
				"opdrachtunion sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          OPDRACHT_ID as integer,",
				"          SOORT_ID as integer,",
				"          WERKVERZOEK_ID as integer,",
				"          OPDRACHTDATUM as string,",
				"          STARTDATUM as string,",
				"          EINDDATUM as string,",
				"          BON as integer,",
				"          AFGEROND as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> OPDRACHTOLTP"
			]
		}
	}
}